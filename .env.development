# Dev-server-only overrides (loaded by Vite in dev alongside .env).
# Enables the native image generation feature in the preview.
VITE_GENERATION_ENABLED=true
GENERATION_ENABLED=true

# Final-verification environment only. This enables capabilities, not execution.
# Do not run images or the frozen matrix without separate execution authorization.
GROUNDING_ENABLED=true
VALIDATION_REPAIR_ENABLED=true
AUTO_REPAIR_POLICY=platform_absorbs_one_per_request
