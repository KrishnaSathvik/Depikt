# Copy to .env and fill in real values. Never commit .env.

# Supabase (public/publishable keys — safe for the browser, but keep out of git anyway)
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# OpenAI (server-side only; used by /api/public/generate-prompt and the benchmark harness)
OPENAI_API_KEY=sk-your-key-here

# Optional: override the canonical site URL used for absolute links / sitemap
# SITE_URL=https://depikt.app
# VITE_SITE_URL=https://depikt.app
