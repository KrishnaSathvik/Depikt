# Copy to .env and fill in real values. Never commit .env.

# Supabase (public/publishable keys — safe for the browser, but keep out of git anyway)
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# OpenAI (server-side only; used by /api/public/generate-prompt and the benchmark harness)
OPENAI_API_KEY=sk-your-key-here

# Supabase service role (server-side only — webhooks, billing sync, account
# deletion; never expose to the browser, never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (server-side only — TEST MODE keys/prices during development; see
# src/lib/billing/plans.ts for the catalog these map to)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-monthly-id
STRIPE_PRICE_PRO_YEARLY=price_your-pro-yearly-id
STRIPE_PRICE_MAX_MONTHLY=price_your-max-monthly-id
STRIPE_PRICE_MAX_YEARLY=price_your-max-yearly-id
STRIPE_PRICE_PACK_10=price_your-pack-10-id
STRIPE_PRICE_PACK_25=price_your-pack-25-id
STRIPE_PRICE_PACK_50=price_your-pack-50-id
# Optional: enable Stripe Tax on Checkout (owner decision, off by default)
# STRIPE_AUTOMATIC_TAX=true

# Optional: override the canonical site URL used for absolute links / sitemap
# SITE_URL=https://depikt.app
# VITE_SITE_URL=https://depikt.app
